DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Option A: Supabase Postgres (recommended) ---
# From Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" URI (port 6543) if your host is serverless; direct (5432) otherwise.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Option B: local Postgres instead (used only if DATABASE_URL is unset) ---
DB_NAME=construction_pm
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Supabase Storage for PDFs / documents (contracts, permits, insurance) ---
USE_SUPABASE_STORAGE=1
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
SUPABASE_S3_BUCKET=documents
SUPABASE_S3_ENDPOINT_URL=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
